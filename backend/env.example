# =============================================================================
# Medical AI Analyzer - Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Do not commit .env files to version control!

# =============================================================================
# Database Configuration (MySQL)
# =============================================================================
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medical_analyzer

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# OpenAI Configuration (for AI-powered Medical Analysis)
# =============================================================================
# Get your API key from https://platform.openai.com/api-keys
# The system uses GPT-4o for intelligent medical document analysis

# Your OpenAI API key (starts with sk-)
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Security Settings
# =============================================================================
# Secret key for JWT token generation (generate with: openssl rand -hex 32)
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# JWT token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# File Upload Configuration
# =============================================================================
# Maximum file size in bytes (10MB = 10485760)
MAX_UPLOAD_SIZE=10485760

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# Upload directory path (relative to backend directory)
UPLOAD_DIR=uploads

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for CORS (comma-separated)
# For development: http://localhost:3000
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
# Enable/disable specific features
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_MEDICAL_ANALYSIS=true
ENABLE_USER_REGISTRATION=true

# =============================================================================
# Logging Configuration
# =============================================================================
# Log file location
LOG_FILE=logs/app.log

# Log rotation settings
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

